---
import type { Lang } from '../data/i18n';
import { translations } from '../data/i18n';
import { siteUrl } from '../data/urls';

interface Props {
  lang: Lang;
  basePath: '/contact' | '/terms' | '/privacy' | '/about' | '/membership';
}

const { lang, basePath } = Astro.props;
const t = translations[lang];
const homeHref = lang === 'en' ? siteUrl('/') : siteUrl('/es/');
const enHref = siteUrl(basePath);
const esHref = siteUrl(`/es${basePath}`);
---
<header class="sub-head">
  <a href={homeHref} class="back">{lang === 'en' ? 'Back' : 'Volver'}</a>
  <div class="brand"><span>|</span><strong>{t.brand} <em>{t.brand2}</em></strong></div>
  <div class="lang">
    <a
      href={enHref}
      data-lang-link="true"
      data-target-path={enHref}
      class={lang === 'en' ? 'active' : ''}
    >EN</a>
    <a
      href={esHref}
      data-lang-link="true"
      data-target-path={esHref}
      class={lang === 'es' ? 'active' : ''}
    >ES</a>
  </div>
</header>

<script>
  document.querySelectorAll('[data-lang-link="true"]').forEach((node) => {
    node.addEventListener('click', (event) => {
      event.preventDefault();
      const targetPath = node.getAttribute('data-target-path') || '';
      window.location.assign(targetPath);
    });
  });
</script>

<style>
  .sub-head { position: sticky; top: 0; z-index: 20; height: 68px; display:flex; align-items:center; justify-content:space-between; padding: 0 1.2rem; background:#fff; border-bottom:1px solid #eee6dd; }
  .back { color:#78716c; text-decoration:none; font-size:.82rem; letter-spacing:.03em; font-weight:600; }
  .back:hover { color: var(--brand-orange); }
  .brand { display:flex; align-items:center; gap:.5rem; font-family:"Cormorant Garamond", serif; text-transform:uppercase; letter-spacing:.14em; font-weight:700; color:#1c1917; }
  .brand span, .brand em { color: var(--brand-orange); font-style: normal; }
  .lang { display:flex; border:1px solid #e7e2dc; }
  .lang a { text-decoration:none; font-size:.7rem; font-weight:800; letter-spacing:.14em; color:#78716c; padding:.45rem .7rem; }
  .lang a.active { background: var(--brand-orange); color:#fff; }
  @media (max-width:600px){ .brand strong{font-size:.9rem;} }
</style>
