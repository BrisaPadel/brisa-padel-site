---
import type { Lang } from '../data/i18n';
import { HERO_IMG, translations } from '../data/i18n';
import { siteUrl, webUrl } from '../data/urls';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const enHref = siteUrl('/');
const esHref = siteUrl('/es/');
const loginHref = webUrl('/login');
const requestAccessPath = lang === 'en' ? '/request-access' : '/es/request-access';
const localizedRequestAccess = lang === 'en' ? webUrl('/request-access') : webUrl('/es/request-access');
const localizedContact = lang === 'en' ? siteUrl('/contact') : siteUrl('/es/contact');
const localizedTerms = lang === 'en' ? siteUrl('/terms') : siteUrl('/es/terms');
const localizedPrivacy = lang === 'en' ? siteUrl('/privacy') : siteUrl('/es/privacy');
---
<div class="home-root" data-lang={lang}>
  <div class="hero-bg" aria-hidden="true">
    <img src={HERO_IMG} alt={t.altHero} loading="eager" fetchpriority="high" />
    <div class="hero-overlay"></div>
  </div>

  <div class="login-wrap">
    <a class="login-btn" href={loginHref} data-app-link="true" data-app-path="/login">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      {t.login}
    </a>
  </div>

  <div class="lang-switch" role="group" aria-label={t.language}>
      <a
        class:list={['lang-btn', { active: lang === 'en' }]}
        href={enHref}
        data-lang-switch="true"
        data-target-lang="en"
        data-target-path={enHref}
      >
        EN
      </a>
      <a
        class:list={['lang-btn', { active: lang === 'es' }]}
        href={esHref}
        data-lang-switch="true"
        data-target-lang="es"
        data-target-path={esHref}
      >
        ES
      </a>
  </div>

  <main class="hero-content">
    <div class="wordmark" aria-label="Brisa Padel">
      <span>|</span>
      <strong>{t.brand} <em>{t.brand2}</em></strong>
      <span>|</span>
    </div>

    <h1>{t.homeHeadline1}<br /><em>{t.homeHeadline2}</em></h1>
    <p>{t.homeSub}</p>
    <a class="cta" href={localizedRequestAccess} data-app-link="true" data-app-path={requestAccessPath}>{t.homeCta}</a>
  </main>

  <footer>
    <a href={lang === 'en' ? siteUrl('/about') : siteUrl('/es/about')}>{lang === 'en' ? 'About' : 'Nosotros'}</a>
    <span>|</span>
    <a href={lang === 'en' ? siteUrl('/membership') : siteUrl('/es/membership')}>
      {lang === 'en' ? 'Membership' : 'Membresía'}
    </a>
    <span>|</span>
    <a href={localizedContact}>{t.homeContact}</a>
    <span>|</span>
    <a href={localizedTerms}>{t.homeTerms}</a>
    <span>|</span>
    <a href={localizedPrivacy}>{t.homePrivacy}</a>
  </footer>
</div>

<script>
  const root = document.querySelector('.home-root');
  const langSwitches = document.querySelectorAll('[data-lang-switch="true"]');
  const appLinks = document.querySelectorAll('[data-app-link="true"]');
  if (root) {
    const currentLang = root.getAttribute('data-lang') || 'en';
    try {
      localStorage.setItem('preferred-lang', currentLang);
    } catch {}
  }

  langSwitches.forEach((langSwitch) => {
    langSwitch.addEventListener('click', (event) => {
      event.preventDefault();
      const targetLang = langSwitch.getAttribute('data-target-lang');
      const targetPath = langSwitch.getAttribute('data-target-path') || '';
      if (!targetLang) return;
      try {
        localStorage.setItem('preferred-lang', targetLang);
      } catch {}
      window.location.assign(targetPath);
    });
  });

  const appHost = location.host.startsWith('app.') ? location.host : `app.${location.host}`;
  const appBase = `${location.protocol}//${appHost}`;
  appLinks.forEach((link) => {
    const path = link.getAttribute('data-app-path');
    if (!path) return;
    link.setAttribute('href', `${appBase}${path}`);
  });
</script>

<style>
  .home-root {
    min-height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #fff;
    padding: 1.5rem;
    font-family: var(--font-sans);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: none;
    animation: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.65));
  }

  .login-wrap {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    z-index: 20;
  }

  .login-btn,
  .lang-btn {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    transition: all 0.2s ease;
  }

  .login-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .login-btn svg {
    width: 12px;
    height: 12px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: translateY(-0.1px);
  }

  .lang-switch {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 20;
    display: inline-flex;
    align-items: center;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .lang-switch .lang-btn {
    border: 0;
    min-width: auto;
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.375rem 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .lang-switch .lang-btn.active {
    background: var(--brand-orange);
    color: #fff;
  }

  .login-btn:hover,
  .lang-btn:hover {
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
  }

  .hero-content {
    z-index: 1;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.5rem;
    margin-top: -1.4vh;
  }

  .wordmark {
    margin-bottom: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.75rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .wordmark span {
    color: var(--brand-orange);
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 300;
    letter-spacing: 0.1em;
  }

  .wordmark em {
    color: var(--brand-orange);
    font-style: normal;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.05;
    margin: 0;
    margin-bottom: 1.5rem;
    max-width: 48rem;
  }

  h1 em {
    color: var(--brand-orange);
    font-style: italic;
    font-weight: 600;
  }

  p {
    margin: 0 0 2.5rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 28rem;
    line-height: 1.625;
    letter-spacing: 0.025em;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .cta {
    background: var(--brand-orange);
    color: #fff;
    text-decoration: none;
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.2em;
    font-weight: 700;
    text-transform: uppercase;
    padding: 1rem 2.5rem;
    box-shadow: 0 10px 15px -3px rgba(242, 100, 25, 0.3), 0 4px 6px -4px rgba(242, 100, 25, 0.3);
    transition: background-color 0.2s ease;
  }

  .cta:hover {
    background: var(--brand-orange-dark);
  }

  footer {
    z-index: 10;
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.98rem;
    align-items: center;
    flex-wrap: nowrap;
    padding: 2.8rem 1.5rem 0.55rem;
  }

  footer a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.181em;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    font-family: var(--font-sans);
  }

  footer a:hover {
    color: #fff;
  }

  footer span {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.75rem;
    line-height: 1rem;
    transform: translateY(-0.5px);
  }

  @media (min-width: 640px) {
    h1 {
      font-size: 3.75rem;
    }

    p {
      font-size: 1rem;
    }
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 4.5rem;
    }
  }

  @media (max-width: 600px) {
    .home-root {
      padding: 1rem;
    }

    .login-wrap {
      top: 1rem;
      left: 1rem;
    }

    .lang-switch {
      top: 1rem;
      right: 1rem;
    }

    h1 {
      font-size: 2.5rem;
    }

    p {
      font-size: 0.88rem;
      margin-bottom: 2rem;
    }

    .cta {
      width: 100%;
      max-width: 17rem;
      padding: 0.95rem 1.6rem;
    }

    .wordmark {
      margin-bottom: 1.4rem;
      font-size: 1rem;
      gap: 0.5rem;
      letter-spacing: 0.35em;
    }

    .hero-content {
      margin-top: -1.2vh;
    }

    footer {
      flex-wrap: wrap;
      gap: 0.6rem;
      padding: 1.9rem 1rem 0.5rem;
    }
  }
</style>
