---
import type { Lang } from '../data/i18n';
import { translations } from '../data/i18n';
import SubpageHeader from './SubpageHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<div class="subpage">
  <SubpageHeader lang={lang} basePath="/contact" />
  <main>
    <p class="label">{lang === 'en' ? 'Get in Touch' : 'Contáctanos'}</p>
    <h1>{lang === 'en' ? "We'd Love to" : 'Nos Encantaría'}<br /><em>{lang === 'en' ? 'Hear From You.' : 'Escucharte.'}</em></h1>
    <p class="intro">{lang === 'en' ? 'Whether you have a question about membership or just want to say hello — our team is here.' : 'Ya sea que tengas una pregunta sobre membresía o simplemente quieras saludar — nuestro equipo está aquí.'}</p>
    <form id="contact-form" class="form" novalidate>
      <label>{lang === 'en' ? 'Full Name' : 'Nombre Completo'} *</label>
      <input name="name" type="text" placeholder="Jane Smith" />
      <small data-err="name"></small>

      <label>{lang === 'en' ? 'Email' : 'Correo Electrónico'} *</label>
      <input name="email" type="email" placeholder="jane@example.com" />
      <small data-err="email"></small>

      <label>{lang === 'en' ? 'Message' : 'Mensaje'} *</label>
      <textarea name="message" rows="5" placeholder={lang === 'en' ? 'How can we help you?' : '¿Cómo podemos ayudarte?'}></textarea>
      <small data-err="message"></small>

      <button type="submit">{lang === 'en' ? 'Send Message' : 'Enviar Mensaje'}</button>
    </form>
    <section id="contact-success" hidden>
      <h2>{lang === 'en' ? 'Message Sent' : 'Mensaje Enviado'}</h2>
      <p>{lang === 'en' ? "Thank you for reaching out. We'll get back to you within one business day." : 'Gracias por contactarnos. Te responderemos dentro de un día hábil.'}</p>
      <a href={lang === 'en' ? '/' : '/es'}>{lang === 'en' ? 'Return Home' : 'Volver al Inicio'}</a>
    </section>
  </main>
</div>

<script>
  const form = document.getElementById('contact-form');
  const success = document.getElementById('contact-success');
  const required = form ? [...form.querySelectorAll('input, textarea')] : [];
  const isSpanish = document.documentElement.lang === 'es';
  const requiredMsg = isSpanish ? 'Requerido' : 'Required';
  const emailMsg = isSpanish ? 'Se requiere un correo electrónico válido' : 'A valid email is required';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let ok = true;
    required.forEach((el) => {
      const name = el.getAttribute('name');
      const target = form.querySelector(`[data-err="${name}"]`);
      if (target) target.textContent = '';
      if (!el.value.trim()) {
        ok = false;
        if (target) target.textContent = requiredMsg;
      }
      if (name === 'email' && el.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value)) {
        ok = false;
        if (target) target.textContent = emailMsg;
      }
    });
    if (!ok) return;
    form.hidden = true;
    if (success) success.hidden = false;
  });
</script>

<style>
  .subpage { min-height: 100vh; background: #faf8f5; }
  main { max-width: 760px; margin: 0 auto; padding: 3.5rem 1.5rem; }
  .label { margin: 0 0 .75rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .16em; color: #8b8178; font-weight: 700; }
  h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.3rem); color:#1c1917; line-height:1.1; margin:0; }
  h1 em { color: var(--brand-orange); font-style: italic; }
  .intro { color:#57534e; line-height:1.7; margin: 0 0 1.5rem; }
  .form { display:grid; gap:.5rem; }
  label { margin-top: .7rem; color:#57534e; font-size:.74rem; font-weight:700; text-transform: uppercase; letter-spacing:.13em; }
  input, textarea { width:100%; border:1px solid #e8e2da; padding:.8rem .9rem; font: inherit; background:#fff; }
  input:focus, textarea:focus { outline:none; border-color: var(--brand-orange); }
  small { min-height:1rem; color: var(--brand-orange); font-size:.75rem; }
  button { margin-top: .8rem; background:var(--brand-orange); color:#fff; border:0; padding: .95rem 1rem; text-transform:uppercase; letter-spacing:.16em; font-weight:800; cursor:pointer; }
  button:hover { background: var(--brand-orange-dark); }
  #contact-success h2 { font-family:var(--font-display); font-size: 2rem; margin-bottom:.4rem; }
  #contact-success p { color:#57534e; margin-bottom:1rem; }
  #contact-success a { background:var(--brand-orange); color:#fff; padding:.7rem 1.3rem; text-decoration:none; text-transform:uppercase; font-size:.75rem; letter-spacing:.14em; font-weight:700; }
</style>
