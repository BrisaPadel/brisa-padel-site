---
import type { Lang } from '../data/i18n';
import SubpageHeader from './SubpageHeader.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isEs = lang === 'es';
---
<div class="subpage">
  <SubpageHeader lang={lang} basePath="/membership" />
  <main>
    <p class="label">{isEs ? 'Membresía' : 'Membership'}</p>
    <h1>{isEs ? 'Membresía Brisa Padel' : 'Brisa Padel Membership'}</h1>
    <p class="intro">
      {isEs
        ? 'Brisa Padel es una comunidad privada basada en aplicación. Tendrás acceso a matchmaking con IA y partidos semanales de 4 jugadores ajustados a tu nivel, horario y estilo.'
        : 'Brisa Padel is a private, application-based community. Membership gives you access to AI-powered matchmaking and weekly four-player matches based on your skill, schedule, and playing style.'}
    </p>

    <section>
      <h2>{isEs ? 'Para quién es' : 'Who membership is for'}</h2>
      <ul>
        <li>{isEs ? 'Juegas pádel al menos dos veces al mes en South Florida.' : 'You play padel at least twice a month in South Florida.'}</li>
        <li>{isEs ? 'Buscas partidos equilibrados con nuevos compañeros.' : 'You want balanced games and new partners beyond your usual circle.'}</li>
        <li>{isEs ? 'Eres confiable y cumples los partidos que aceptas.' : 'You are reliable and show up to matches you accept.'}</li>
      </ul>
    </section>

    <section>
      <h2>{isEs ? 'Cómo aplicar' : 'How to apply'}</h2>
      <ol>
        <li>{isEs ? 'Completa la solicitud (toma ~5 minutos).' : 'Submit your application (about 5 minutes).'}</li>
        <li>{isEs ? 'Comparte nivel, lado, frecuencia y clubes preferidos.' : 'Share your level, side preference, frequency, and club preferences.'}</li>
        <li>{isEs ? 'Espera revisión (normalmente en 48 horas).' : 'Wait for review (most decisions within 48 hours).'}</li>
        <li>{isEs ? 'Onboarding por WhatsApp si eres aprobado.' : 'Get onboarded over WhatsApp after approval.'}</li>
      </ol>
      <a class="cta" href={isEs ? '/es/contact' : '/contact'}>{isEs ? 'Comenzar solicitud' : 'Start application'}</a>
    </section>

    <section>
      <h2>{isEs ? 'Incluye' : "What's included"}</h2>
      <ul>
        <li>{isEs ? 'Sugerencias semanales por WhatsApp.' : 'Weekly match suggestions via WhatsApp.'}</li>
        <li>{isEs ? 'Tipos de partido: networking, competitivo, money matches, match-lessons.' : 'Match type options: networking, competitive, money matches, match-lessons.'}</li>
        <li>{isEs ? 'Coordinación automática y rating de nivel (WPR).' : 'AI-handled coordination and skill rating updates (WPR).'}</li>
        <li>{isEs ? 'Soporte bilingüe (inglés/español).' : 'Bilingual support in English and Spanish.'}</li>
      </ul>
    </section>

    <section>
      <h2>{isEs ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h2>
      <p><strong>{isEs ? '¿Necesito jugar en un club específico?' : 'Do I need to be at a specific club?'}</strong> {isEs ? 'No. Coordinamos entre varios clubes.' : 'No. We coordinate across multiple clubs.'}</p>
      <p><strong>{isEs ? '¿Quién paga la cancha?' : 'Who pays for the court?'}</strong> {isEs ? 'Los jugadores dividen el costo entre ellos.' : 'Court fees are split between players directly.'}</p>
      <p><strong>{isEs ? '¿Puedo cancelar?' : 'Can I cancel?'}</strong> {isEs ? 'Sí, vía soporte. Revisa términos para detalles.' : 'Yes, through support. See terms for details.'}</p>
    </section>

    <section>
      <h2>{isEs ? '¿Listo para aplicar?' : 'Ready to apply?'}</h2>
      <a class="cta" href={isEs ? '/es/contact' : '/contact'}>{isEs ? 'Enviar solicitud' : 'Submit your application'}</a>
      <p class="support">{isEs ? '¿Preguntas? Escríbenos.' : 'Questions before applying? Contact us.'} <a href={isEs ? '/es/contact' : '/contact'}>{isEs ? 'Contacto' : 'Contact'}</a></p>
    </section>
  </main>
</div>

<style>
  .subpage { min-height: 100vh; background: #faf8f5; }
  main { max-width: 760px; margin: 0 auto; padding: 3.5rem 1.5rem; }
  .label { margin: 0 0 .75rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .16em; color: #8b8178; font-weight: 700; }
  h1 { font-family:"Cormorant Garamond", serif; font-size: clamp(2rem, 5vw, 3.3rem); margin: 0 0 .8rem; color:#1c1917; }
  .intro { color:#57534e; line-height:1.7; margin: 0 0 1.5rem; }
  section { margin-top: 1.6rem; }
  h2 { font-family:"Cormorant Garamond", serif; border-left:2px solid var(--brand-orange); padding-left:.8rem; color:#1c1917; margin:0 0 .7rem; font-size:1.42rem; }
  p { margin: 0; color:#57534e; line-height:1.65; }
  ul, ol { margin: .7rem 0 0; padding-left: 1.2rem; color:#57534e; line-height:1.65; }
  .cta { display:inline-block; margin-top: .9rem; background:var(--brand-orange); color:#fff; padding:.7rem 1.3rem; text-decoration:none; text-transform:uppercase; font-size:.75rem; letter-spacing:.14em; font-weight:700; }
  .support { margin-top: .6rem; }
  .support a { color: var(--brand-orange-dark); }
</style>
